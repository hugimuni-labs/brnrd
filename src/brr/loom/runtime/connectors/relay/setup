#!/usr/bin/env python3
"""Account pairing stays with the existing browser flow."""
import os
from pathlib import Path
from brr.loom.runtime import gates
from brr.loom.runtime.config import load_config

root = Path(os.environ['BRNRD_CONFIG']).parent.parent
if gates.state_dir(root, load_config(root)) is None:
    raise SystemExit('relay needs a cloud gate in loom/gates: run `brnrd account connect` for '
                     'browser pairing. Connect the chat on brnrd.dev before retrying channel setup.')
