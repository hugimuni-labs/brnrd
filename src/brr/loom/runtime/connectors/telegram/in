#!/usr/bin/env python3
"""Long-poll a bot; publish attachments, then a letter, then its cursor."""
import json
import signal
import sys
import threading
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent))
from common import call, download, message_id, state
from brr.channels.telegram import extract_attachments, parse_update
from brr.loom.runtime.home import atomic_write
from brr.loom.runtime.port import _front


# A bot may fetch a file of at most 20 MB: https://core.telegram.org/bots/api#getfile
FETCH_MAX = 20 * 2**20


def receive(drop, update, more=()):
    """One letter from an update, with the files of ``more``: the rest of its album."""
    parsed = parse_update(update)
    if parsed is None or parsed.is_edit:
        return
    ident = message_id(parsed.chat_id, parsed.message_id)
    if (drop / f'{ident}.md').exists():
        return
    texts = [parsed.text] if parsed.text else []
    pointers = []
    for item in (update, *more):
        msg = item.get('message') or {}
        if item is not update:
            extra = parse_update(item)
            if extra is not None and extra.text:
                texts.append(extra.text)
        for pointer in extract_attachments(msg):
            # The name extract_attachments gives carries the extension (a voice has no file_name).
            suffix = Path(pointer['filename']).suffix
            pointers.append((pointer['file_id'], suffix if suffix[1:].isalnum() else '',
                             pointer.get('file_size')))
    missing, large = [], []
    for index, (file_id, suffix, size) in enumerate(pointers):
        dest = drop / f'{ident}.d' / f'{index}{suffix}'
        if dest.exists():
            continue
        if isinstance(size, int) and size > FETCH_MAX:
            large.append(f'{index}:{size}')
            continue
        for attempt in range(3):
            try:
                atomic_write(dest, download(file_id))
                break
            except Exception:
                if attempt == 2:
                    missing.append(str(index))
    fields = dict(kind='letter', id=ident, to=parsed.chat_id)
    if parsed.user_id is not None:
        fields['from'] = str(parsed.user_id)
    if parsed.reply_to_message_id is not None:
        fields['re'] = message_id(parsed.chat_id, parsed.reply_to_message_id)
    if missing:
        fields['missing'] = ' '.join(missing)
    if large:
        fields['large'] = ' '.join(large)
    atomic_write(drop / f'{ident}.md', _front(fields, '\n'.join(texts)))


def batch(updates):
    """Updates as ``(first, rest)``: the items of one album in this batch go with its first.

    An album split across two batches stays two letters: nothing is held back,
    so nothing is lost when the poll stops between them."""
    groups, order = {}, []
    for update in updates:
        msg = update.get('message') if isinstance(update, dict) else None
        group = msg.get('media_group_id') if isinstance(msg, dict) else None
        key = (str((msg.get('chat') or {}).get('id')), str(group)) if group is not None else id(update)
        if key not in groups:
            groups[key] = []
            order.append(key)
        groups[key].append(update)
    return [(groups[key][0], groups[key][1:]) for key in order]


def poll(drop, stop):
    cursor = state() / 'cursor'
    offset = int(cursor.read_text()) if cursor.exists() else 0
    delay = 1
    while not stop.is_set():
        try:
            updates = call('getUpdates', dict(offset=offset, timeout=25, allowed_updates=['message']))
            for first, rest in batch(updates):
                receive(drop, first, rest)
                offset = max(u['update_id'] for u in (first, *rest)) + 1
                atomic_write(cursor, str(offset))
            delay = 1
        except Exception as exc:
            # The message names no URL (common.call keeps the token out of it).
            print(f'telegram: {exc or type(exc).__name__}; retry in {delay}s', file=sys.stderr)
            stop.wait(delay)
            delay = min(60, delay * 2)


if __name__ == '__main__':
    stop = threading.Event()
    signal.signal(signal.SIGTERM, lambda *_: stop.set())
    signal.signal(signal.SIGINT, lambda *_: stop.set())
    drop = Path(sys.argv[1])
    drop.mkdir(parents=True, exist_ok=True)
    poll(drop, stop)
