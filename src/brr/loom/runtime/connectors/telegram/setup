#!/usr/bin/env python3
"""Keep the bot credential private to this channel instance."""
import getpass
import os
import re
import sys
from pathlib import Path

from brr.loom.runtime.config import SECRET_SOURCES

TRIES = 3


def ask(attempt):
    # A hidden prompt can come back empty: a paste that starts with a newline
    # ends it at once, and some terminals drop a paste into a hidden field.
    # Every later try is a visible prompt.
    if attempt == 0:
        return getpass.getpass('BotFather token (or command:/file:/env: secret source): ')
    return input('Paste the token here (it shows on screen), or file:<path> to a file holding it: ')


def problem(value):
    if not value:
        return 'Received 0 characters.'
    if value.partition(':')[0] in SECRET_SOURCES:
        return None
    if not re.fullmatch(r'\d+:[A-Za-z0-9_-]+', value):
        return f'Received {len(value)} characters, which is not a BotFather token (digits, a colon, then letters).'
    return None


path = Path(os.environ['BRNRD_STATE']) / 'token'
for attempt in range(TRIES):
    try:
        value = ask(attempt).strip()
    except EOFError:
        raise SystemExit('No token: input closed before one arrived') from None
    message = problem(value)
    if message is None:
        break
    print(message, file=sys.stderr)
else:
    raise SystemExit(f'No token after {TRIES} tries; rerun brnrd setup --kind telegram with the token in a file and answer file:<path>')
fd = os.open(path, os.O_CREAT | os.O_TRUNC | os.O_WRONLY, 0o600)
with os.fdopen(fd, 'w') as stream:
    os.fchmod(stream.fileno(), 0o600)
    stream.write(value + '\n')
