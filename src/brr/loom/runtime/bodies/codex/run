#!/usr/bin/env python3
import json
import os
import sys
from brr.loom.runtime.port import wake_parts

room, core = sys.argv[1:]
# developer_instructions lands as a developer message after Codex's own base
# instructions; the user turn carries only the occasion.
core_text, occasion = wake_parts(os.environ)
system = ["-c", "developer_instructions=" + json.dumps(core_text, ensure_ascii=False)] if core_text else []
os.execvp("codex", ["codex", "exec", "--ignore-user-config", "--model", core,
                    "--dangerously-bypass-approvals-and-sandbox", "--json",
                    "-c", 'shell_environment_policy.inherit="all"', *system, "--",
                    occasion])
