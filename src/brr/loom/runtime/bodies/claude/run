#!/usr/bin/env python3
import json
import os
import sys
from pathlib import Path
from brr.loom.runtime.port import wake_parts

room, core = sys.argv[1:]
room = Path(room)
def hook(event, timeout):
    return {"type": "command", "command": os.environ["BRNRD_JACK"] + " --event " + event,
            "timeout": timeout}
settings = {"hooks": {
    "SessionStart": [{"hooks": [hook("start", 60)]}],
    # Guards warn before a call runs (guards.py); never a boundary.
    "PreToolUse": [{"matcher": ".*", "hooks": [hook("pre", 60)]}],
    "PostToolUse": [{"matcher": ".*", "hooks": [hook("post", 60)]}],
    # A failed call, and a paused one (pausing.py), is a boundary too.
    "PostToolUseFailure": [{"matcher": ".*", "hooks": [hook("post", 60)]}],
    "SubagentStop": [{"hooks": [hook("subagent-stop", 60)]}],
    "Stop": [{"hooks": [hook("stop", int(os.environ.get("BRNRD_STOP_TIMEOUT") or float(os.environ["BRNRD_WAIT"]) + 60))]}],
}}
path = room / ".claude/settings.json"
path.parent.mkdir(parents=True, exist_ok=True)
path.write_text(json.dumps(settings) + "\n")
# The self's core is appended to Claude Code's own system prompt, never put
# in its place; the user turn carries only the occasion.
core_text, occasion = wake_parts(os.environ)
system = ["--append-system-prompt-file", os.environ["BRNRD_CORE"]] if core_text else []
# An empty core leaves the model to Claude Code: the person's own /model.
model = ["--model", core] if core else []
os.execvp("claude", ["claude", "-p", *model, "--settings", str(path), *system,
                     "--dangerously-skip-permissions", "--", occasion])
