#!/bin/sh
# 30-widening <old> <new>
#
# A Widening trailer must name a clause that exists at <new>.
#   Widening: people/<name>/agreement.md#<clause-id>
# A clause is a line of that file containing {#<clause-id>}.
# Existence only. A hook can't parse prose. No trailer is fine.
# One stderr line per commit and bad citation.

old=${1:-}
new=${2:-}
if [ -z "$old" ] || [ -z "$new" ]; then
    printf 'usage: 30-widening <old> <new>\n' >&2
    exit 2
fi

tmp=$(mktemp -d "${TMPDIR:-/tmp}/30-widening.XXXXXX") || {
    printf 'mktemp failed\n' >&2
    exit 1
}
trap 'rm -rf "$tmp"' EXIT

zeros_p() {
    case "$1" in
        ""|*[!0]*) return 1 ;;
        *) return 0 ;;
    esac
}

if zeros_p "$old"; then
    git rev-list --reverse "$new" >"$tmp/commits" 2>/dev/null || : >"$tmp/commits"
else
    git rev-list --reverse "${old}..${new}" >"$tmp/commits" 2>/dev/null || : >"$tmp/commits"
fi

status=0
while IFS= read -r sha || [ -n "$sha" ]; do
    [ -n "$sha" ] || continue
    short=$(printf '%s' "$sha" | cut -c1-12)
    msg=$(git log -1 --format=%B "$sha" 2>/dev/null || true)
    printf '%s\n' "$msg" | git interpret-trailers --parse 2>/dev/null |
        sed -n 's/^Widening:[[:space:]]*//p' >"$tmp/widen"
    while IFS= read -r cite || [ -n "$cite" ]; do
        [ -n "$cite" ] || continue
        ok=0
        case "$cite" in
            people/*/agreement.md#*)
                file=${cite%%#*}
                clause=${cite#*#}
                case "$clause" in
                    *[!A-Za-z0-9_-]*|"") ;;
                    *)
                        mid=${file#people/}
                        mid=${mid%/agreement.md}
                        case "$mid" in
                            ""|*/*|.*|..) ;;
                            *)
                                if git show "$new:$file" 2>/dev/null | grep -F "{#$clause}" >/dev/null 2>&1; then
                                    ok=1
                                fi
                                ;;
                        esac
                        ;;
                esac
                ;;
        esac
        if [ "$ok" -eq 0 ]; then
            printf '%s: widening %s\n' "$short" "$cite" >&2
            status=1
        fi
    done <"$tmp/widen"
done <"$tmp/commits"

exit "$status"
