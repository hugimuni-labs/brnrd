#!/usr/bin/env python3
"""Refuse changed rule files that do not declare how they are kept.

A rule is one file, memory/rules/<id>.md: frontmatter, then the rule's text.
Keys: id (the file's stem) and when (a non-empty list of words or phrases).
A rule with when is a trigger; without it, a wake rule. check is reserved
and refused until the self has a check point for it; any other key is
refused, so nothing is silently ignored. Anything else under memory/rules/
except .gitkeep is refused too. The frontmatter line grammar is 10-readme's.
--file checks one file; an all-zero old tip checks every incoming rule.
Git's hook environment, including GIT_DIR, is kept.
"""

from pathlib import Path
import subprocess
import sys

KEYS = ("id", "when")
LETTERS = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
ID_CHARS = LETTERS + "0123456789_-"


class Refusal(Exception):
    pass


def unquote(value):
    if value.startswith('"') and value.endswith('"') and len(value) >= 2:
        inner = value[1:-1]
        if '"' not in inner:
            return inner
    elif '"' not in value:
        return value
    raise Refusal(f"unclosed quote: {value}")


def parse_list(raw, key):
    if not raw.endswith("]"):
        raise Refusal(f"list unclosed: {key}")
    inner = raw[1:-1].strip(" ")
    if not inner:
        return []
    items = []
    for part in inner.split(","):
        piece = part.strip(" ")
        if not piece:
            raise Refusal(f"list malformed: {key}")
        items.append(unquote(piece))
    return items


def frontmatter(lines):
    if not lines or lines[0] != "---":
        raise Refusal("frontmatter missing")
    try:
        end = lines.index("---", 1)
    except ValueError:
        raise Refusal("frontmatter unclosed") from None
    values = {}
    for line in lines[1:end]:
        if line == "":
            continue
        key, separator, raw = line.partition(":")
        key = key.strip(" ")
        if (line.startswith((" ", "\t")) or not separator or not key
                or key[0] not in LETTERS or any(char not in ID_CHARS for char in key)):
            raise Refusal(f"frontmatter line not key: value: {line}")
        if key in values:
            raise Refusal(f"duplicate key: {key}")
        raw = raw.strip(" ")
        values[key] = parse_list(raw, key) if raw.startswith("[") else unquote(raw)
    return values, lines[end + 1:]


def check_content(content, stem):
    lines = content.replace("\r", "").split("\n")
    if lines and lines[-1] == "":
        lines.pop()
    values, body = frontmatter(lines)
    if "check" in values:
        raise Refusal("check: not supported yet; use when: or no key (a wake rule)")
    unknown = sorted(key for key in values if key not in KEYS)
    if unknown:
        raise Refusal(f"unknown key: {', '.join(unknown)} (keys: {', '.join(KEYS)})")
    ident = values.get("id", "")
    if not isinstance(ident, str) or not ident:
        raise Refusal("id missing")
    if ident != stem:
        raise Refusal(f"id {ident} is not file stem {stem}")
    if "when" in values:
        when = values["when"]
        if not isinstance(when, list):
            raise Refusal("when must be a list: when: [word, \"a phrase\"]")
        if not when or any(not word.strip() for word in when):
            raise Refusal("when is empty; drop it for a wake rule")
    if not any(line.strip() for line in body):
        raise Refusal("rule text missing")


def stem_of(path):
    """The rule id a path must carry, or a Refusal for a path that is no rule."""
    parts = path.split("/")
    name = parts[-1]
    if len(parts) != 3 or not name.endswith(".md") or len(name) == 3:
        raise Refusal("not a rule file; rules are memory/rules/<id>.md")
    stem = name[:-3]
    if stem[0] not in LETTERS + "0123456789" or any(char not in ID_CHARS for char in stem):
        raise Refusal("rule id must be letters, digits, _ or -")
    return stem


def check(display, content, rel):
    try:
        check_content(content, stem_of(rel))
        return 0
    except Refusal as exc:
        print(f"{display}: {exc}", file=sys.stderr)
        return 1


def git(*args):
    return subprocess.run(["git", *args], capture_output=True)


def usage():
    print("usage: 30-rules <old> <new> | 30-rules --file PATH", file=sys.stderr)
    return 2


def main(args):
    if len(args) != 2:
        return usage()
    if args[0] == "--file":
        path = Path(args[1])
        if not path.is_file():
            print(f"{args[1]}: no such file", file=sys.stderr)
            return 1
        content = path.read_bytes().decode("utf-8", "surrogateescape")
        return check(args[1], content, f"memory/rules/{path.name}")
    old, new = args
    if not old:
        return usage()
    if all(char == "0" for char in old):
        paths = git("ls-tree", "-r", "--name-only", new, "--", "memory/rules")
    else:
        paths = git("diff", "--name-only", "--diff-filter=ACMRT", old, new, "--", "memory/rules")
    if paths.returncode:
        sys.stderr.buffer.write(paths.stderr)
        return paths.returncode
    status = 0
    for path in paths.stdout.decode("utf-8", "surrogateescape").split("\n"):
        if not path or path == "memory/rules/.gitkeep":
            continue
        blob = git("show", f"{new}:{path}")
        if blob.returncode:
            print(f"{path}: unreadable at {new}", file=sys.stderr)
            status = 1
            continue
        status |= check(path, blob.stdout.decode("utf-8", "surrogateescape"), path)
    return status


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
