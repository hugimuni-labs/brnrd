#!/usr/bin/env python3
"""Refuse changed thread READMEs with invalid frontmatter, heading or folder id.

Required fields are id, status and tense; reference requires settled status,
and goal requires measure. measure, on any thread, is a path inside the self
to a file committed with mode 100755 at the incoming tip (not checked by --file).
A push that changes a measure file re-checks the READMEs naming it.
Keys must be unique ASCII names, values must have balanced quotes and lists,
and for must be a string. Only an empty line is skipped, and required lists
remain literal strings: these are the shell gate's verdicts, not a new grammar.
--file checks one file; an all-zero old tip checks every incoming README.
Git's hook environment, including GIT_DIR, is kept so bare hooks find the repo.
"""

from pathlib import Path
import subprocess
import sys


class Refusal(Exception):
    pass


def unquote(value):
    if value.startswith('"') and value.endswith('"') and len(value) >= 2:
        inner = value[1:-1]
        if '"' not in inner:
            return inner
    elif '"' not in value:
        return value
    raise Refusal(f"unclosed quote: {value}")


def frontmatter_line(line, values):
    if line == "":
        return
    key, separator, raw = line.partition(":")
    key = key.strip(" ")
    letters = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
    allowed = letters + "0123456789_-"
    if (line.startswith((" ", "\t")) or not separator or not key
            or key[0] not in letters or any(char not in allowed for char in key)):
        raise Refusal(f"frontmatter line not key: value: {line}")
    if key in values:
        raise Refusal(f"duplicate key: {key}")
    raw = raw.strip(" ")
    if raw.startswith("["):
        if key == "for":
            raise Refusal("for must be a string")
        if not raw.endswith("]"):
            raise Refusal(f"list unclosed: {key}")
        inner = raw[1:-1].strip(" ")
        if inner:
            for part in inner.split(","):
                piece = part.strip(" ")
                if not piece:
                    raise Refusal(f"list malformed: {key}")
                unquote(piece)
        values[key] = raw  # Shell stores lists literally, even required fields.
    else:
        values[key] = unquote(raw)


def require_fields(values):
    for key, options in (("id", None), ("status", "open|live|dormant|settled|retired"),
                         ("tense", "plan|reference|goal")):
        value = values.get(key, "")
        if not value:
            raise Refusal(f"{key} missing")
        if options and value not in options.split("|"):
            raise Refusal(f"{key} {value} is not one of {options}")
    if values["tense"] == "reference" and values["status"] != "settled":
        raise Refusal("tense reference requires status settled")
    if values["tense"] == "goal" and not values.get("measure"):
        raise Refusal("tense goal requires measure")
    if "measure" in values:
        measure_path(values["measure"])


def measure_path(value):
    """A relative path inside the self: no leading /, no empty, . or .. segment."""
    parts = value.split("/")
    if not value or value.startswith("[") or any(part in ("", ".", "..") for part in parts):
        raise Refusal(f"measure is not a path inside the self: {value}")
    return value


def check_content(content, folder):
    # The shell removes every CR and splits only on LF, even for CRLF input.
    lines = content.replace("\r", "").split("\n")
    if lines[-1] == "":
        lines.pop()
    if not lines or lines[0] != "---":
        raise Refusal("frontmatter missing")
    try:
        end = lines.index("---", 1)
    except ValueError:
        raise Refusal("frontmatter unclosed") from None
    values = {}
    for line in lines[1:end]:
        frontmatter_line(line, values)
    require_fields(values)
    heading = next((line for line in lines[end + 1:] if line != ""), None)
    if heading is None:
        raise Refusal("heading missing")
    rest = heading[2:]
    if not heading.startswith("# ") or rest.startswith("#") or not rest.strip():
        raise Refusal("heading must be a single '# ' line")
    if folder and values["id"] != folder:
        raise Refusal(f"id {values['id']} is not folder {folder}")
    return values


def measure_at(path, revision):
    """Refuse a measure that is not an executable blob at the revision."""
    entry = git("ls-tree", revision, "--", path)
    fields = entry.stdout.decode("utf-8", "surrogateescape").split(None, 3)
    if entry.returncode or not fields:
        raise Refusal(f"measure {path} missing at {revision}")
    if fields[0] != "100755" or fields[1] != "blob":
        raise Refusal(f"measure {path} is not executable (mode {fields[0]}, want 100755)")


def check(display, content, folder, revision=None):
    try:
        values = check_content(content, folder)
        if revision is not None and "measure" in values:
            measure_at(values["measure"], revision)
        return 0
    except Refusal as exc:
        print(f"{display}: {exc}", file=sys.stderr)
        return 1


def git(*args):
    return subprocess.run(["git", *args], capture_output=True)


def usage():
    print("usage: 10-readme <old> <new> | 10-readme --file PATH", file=sys.stderr)
    return 2


def main(args):
    if len(args) != 2:
        return usage()
    if args[0] == "--file":
        path = Path(args[1])
        if not path.is_file():
            print(f"{args[1]}: no such file", file=sys.stderr)
            return 1
        content = path.read_bytes().decode("utf-8", "surrogateescape")
        folder = (path.parent.name or str(path.parent)) if path.name == "README.md" else ""
        return check(args[1], content, folder)
    old, new = args
    if not old:
        return usage()
    every = git("ls-tree", "-r", "--name-only", new, "--", "threads")
    if every.returncode:
        sys.stderr.buffer.write(every.stderr)
        return every.returncode
    readmes = [path for path in names(every) if is_readme(path)]
    if all(char == "0" for char in old):
        chosen = readmes
    else:
        changed = git("diff", "--name-only", "--no-renames", old, new)
        if changed.returncode:
            sys.stderr.buffer.write(changed.stderr)
            return changed.returncode
        touched = set(names(changed))
        chosen = [path for path in readmes
                  if path in touched or names_measure_in(path, new, touched)]
    status = 0
    for path in chosen:
        blob = git("show", f"{new}:{path}")
        if blob.returncode:
            print(f"{path}: unreadable at {new}", file=sys.stderr)
            status = 1
            continue
        text = blob.stdout.decode("utf-8", "surrogateescape")
        status |= check(path, text, path.split("/")[1], new)
    return status


def names(proc):
    return [path for path in proc.stdout.decode("utf-8", "surrogateescape").split("\n") if path]


def is_readme(path):
    parts = path.split("/")
    return len(parts) == 3 and parts[0] == "threads" and parts[1] and parts[2] == "README.md"


def names_measure_in(path, revision, touched):
    """An unchanged README is judged again when the file its measure names changed."""
    blob = git("show", f"{revision}:{path}")
    if blob.returncode:
        return False
    for line in blob.stdout.decode("utf-8", "surrogateescape").replace("\r", "").split("\n")[1:]:
        if line == "---":
            return False
        key, separator, raw = line.partition(":")
        if separator and key.strip(" ") == "measure":
            value = raw.strip(" ")
            if len(value) >= 2 and value[0] == value[-1] == '"':
                value = value[1:-1]
            return value in touched
    return False


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
