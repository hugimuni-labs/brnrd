#!/usr/bin/env python3
"""Wake recipe. The self owns this file; it imports nothing from brnrd.

    core/loom/wake <thread-id> <owed.json>

stdout is the prompt. Exit 0 is ok, exit 3 is over budget (stderr says
what did not fit), anything else is a broken recipe.

LOOM_BUDGET_BYTES defaults to 24000. LOOM_PART is a file, written by the loom.
When LOOM_CORE names a file, the core (identity, stance and role) is written there
and left out of stdout: a body that has a system slot carries it there, where
automated turns and compaction do not wear it down. The budget still counts it.
The tree is cut from the bottom, and a narrowed wake says how many entries
were left out. Then the thread's README folds whole `## ` sections but `## Now` to their
titles, last first, and only then is cut from its end; each cut says so: it
is the one part the waking body can fix, so it never costs a letter. The
identity, the stance, the role, the notes and the occasion are never cut.
"""

from __future__ import annotations

import json
import os
import subprocess
import sys
from pathlib import Path

DEFAULT_BUDGET = 24000
TREE_ROOTS = ("memory", "threads", "people")
_PINNED = ("GIT_DIR", "GIT_WORK_TREE", "GIT_INDEX_FILE")


def die(why: str, code: int = 1) -> None:
    print(why, file=sys.stderr)
    raise SystemExit(code)


def segment(value: str) -> str:
    if not value or value in {".", ".."} or "/" in value or "\\" in value:
        die(f"thread id is not a single path segment: {value}")
    return value


def budget() -> int:
    raw = os.environ.get("LOOM_BUDGET_BYTES")
    if raw is None or raw == "":
        return DEFAULT_BUDGET
    if not raw.isdigit():
        die(f"LOOM_BUDGET_BYTES is not a nonnegative integer: {raw}")
    return int(raw)


def ensure_nl(text: str) -> str:
    return text if text.endswith("\n") else text + "\n"


def section(title: str, body: str) -> str:
    return f"## {title}\n{ensure_nl(body)}"


def read_exact(path: Path, why: str) -> str:
    if not path.is_file():
        die(f"{why}: no such file")
    try:
        return path.read_text(encoding="utf-8")
    except UnicodeDecodeError as exc:
        die(f"{why}: not utf-8: {exc}")
    raise AssertionError("unreachable")


def git_times(root: Path) -> dict[str, int]:
    """Last commit time per path, in one ``git log`` pass (newest first)."""
    env = os.environ.copy()
    for key in _PINNED:
        env.pop(key, None)
    proc = subprocess.run(
        ["git", "log", "--format=%x00%ct", "--name-only", "--", *TREE_ROOTS],
        cwd=root,
        env=env,
        capture_output=True,
        text=True,
    )
    times: dict[str, int] = {}
    if proc.returncode != 0:
        return times
    stamp = 0
    for line in proc.stdout.splitlines():
        if line.startswith("\x00"):
            stamp = int(line[1:]) if line[1:].isdigit() else 0
        elif line and line not in times:
            times[line] = stamp
    return times


def first_line(path: Path, why: str) -> str:
    """The first non-empty line after any frontmatter: a README's headline."""
    lines = read_exact(path, why).splitlines()
    if lines and lines[0] == "---" and "---" in lines[1:]:
        lines = lines[lines.index("---", 1) + 1 :]
    return next((line for line in lines if line.strip()), "")


def tree_lines(root: Path, thread: str) -> list[str]:
    rows: list[tuple[int, str, str]] = []
    times = git_times(root)
    for top in TREE_ROOTS:
        base = root / top
        if not base.is_dir():
            continue
        for path in base.rglob("*.md"):
            if not path.is_file() or path.is_symlink():
                continue
            rel = path.relative_to(root)
            parts = rel.parts
            if "hearth" in parts:
                continue
            posix = rel.as_posix()
            if posix == "memory/stance.md":
                continue
            if posix == f"threads/{thread}/README.md":
                continue
            if (
                len(parts) >= 3
                and parts[0] == "threads"
                and parts[1] == thread
                and parts[2] == "notes"
            ):
                continue
            line = f"{posix} · {first_line(path, posix)} · {path.stat().st_size}"
            rows.append((times.get(posix, 0), posix, line))
    rows.sort(key=lambda row: (-row[0], row[1]))
    return [row[2] for row in rows]


def notes_block(root: Path, thread: str) -> str:
    folder = root / "threads" / thread / "notes"
    if not folder.is_dir():
        return ""
    files = [path for path in folder.rglob("*") if path.is_file() and not path.is_symlink()]
    chunks = []
    for path in sorted(files, key=lambda item: item.relative_to(root).as_posix()):
        rel = path.relative_to(root).as_posix()
        chunks.append(section(rel, read_exact(path, rel)))
    return "".join(chunks)


def occasion(path: Path) -> str:
    if not path.is_file():
        die(f"owed.json: no such file: {path}")
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as exc:
        die(f"owed.json: {exc}")
    except UnicodeDecodeError as exc:
        die(f"owed.json: not utf-8: {exc}")
    if not isinstance(data, list):
        die("owed.json: expected a list")
    chunks = ["## Occasion\n"]
    for item in data:
        if not isinstance(item, dict) or any(key not in item for key in ("id", "from", "body")):
            die("owed.json: each letter needs id, from, body")
        ident, sender, body = item["id"], item["from"], item["body"]
        if not all(isinstance(value, str) for value in (ident, sender, body)):
            die("owed.json: id, from and body must be strings")
        chunks.append(f"### {ident} from {sender} · reply {item.get('reply_to', '-')}\n{ensure_nl(body)}")
        if item.get("reply_context"):
            chunks.append(ensure_nl(item["reply_context"]))
        chunks.extend(ensure_nl(line) for line in item.get("attachments", ()))
    return "".join(chunks)


def fold(readme: str, excess: int) -> str:
    """The README with whole ``## `` sections folded to their titles, last first, until
    ``excess`` bytes are saved. The spec above the first section and ``## Now`` are never
    folded: they are what the thread is for and what its successor boots into. Each fold
    says so; what is still over is cut from the end."""
    lines = readme.splitlines(keepends=True)
    starts = [i for i, line in enumerate(lines) if line.startswith("## ")]
    if not starts:
        return readme
    bounds = list(zip(starts, starts[1:] + [len(lines)]))
    now = [b for b in bounds if lines[b[0]].strip().lower() == "## now"]
    order = [b for b in reversed(bounds) if b not in now]
    folded: dict[int, str] = {}
    saved = 0
    for start, end in order:
        if saved >= excess:
            break
        body = "".join(lines[start + 1:end])
        size = len(body.encode("utf-8"))
        note = f"[the wake folded this section's {size} bytes to its title; it is whole on disk]\n"
        if size <= len(note.encode("utf-8")):
            continue
        folded[start] = note
        saved += size - len(note.encode("utf-8"))
    out = []
    skip = -1
    for i, line in enumerate(lines):
        if i < skip:
            continue
        out.append(line)
        if i in folded:
            out.append(folded[i])
            skip = next(end for start, end in bounds if start == i)
    return "".join(out)


def clip(readme: str, excess: int, limit: int) -> str:
    """The README less ``excess`` bytes from its end, cut at a line, with a receipt."""
    data = readme.encode("utf-8")
    note = (f"[the wake cut {{}} of this README's {len(data)} bytes from its end to fit the "
            f"{limit}-byte budget; the file is whole on disk: trim it]\n")
    keep = len(data) - excess - len(note.format(len(data)).encode("utf-8"))
    kept = data[:max(0, keep)].decode("utf-8", "ignore")
    kept = kept[: kept.rfind("\n") + 1] if "\n" in kept else ""
    # A README smaller than the excess is cut whole, not kept whole.
    return kept + note.format(len(data) - len(kept.encode("utf-8")))


def core_text(root: Path) -> str:
    """Who wakes, whatever the occasion. Nothing per-wake goes here."""
    identity = read_exact(root / "core" / "identity.md", "core/identity.md")
    stance = read_exact(root / "memory" / "stance.md", "memory/stance.md")
    # The loom adds its briefing after the stance; the self does not keep it.
    return section("core/identity.md", identity) + section("memory/stance.md", stance)


def fixed_text(root: Path, thread: str, loom: str, owed: Path, excess: int = 0, limit: int = 0) -> tuple[str, str]:
    """The parts never cut, as (before the tree, after the tree).

    The occasion goes last: it is what this wake is for.
    """
    readme_path = root / "threads" / thread / "README.md"
    readme = read_exact(readme_path, f"threads/{thread}/README.md")
    if excess:
        size = len(readme.encode("utf-8"))
        readme = fold(readme, excess)
        rest = excess - (size - len(readme.encode("utf-8")))
        if rest > 0:
            readme = clip(readme, rest, limit) or readme
    parts = [
        core_text(root),
        section(f"threads/{thread}/README.md", readme),
        notes_block(root, thread),
    ]
    return "".join(parts), section("Loom", loom) + occasion(owed)


def piece_sizes(text: str) -> list[tuple[str, int]]:
    """Name the uncullable sections by their headings, for the exit-3 line."""
    sizes: list[tuple[str, int]] = []
    current = "preamble"
    buf: list[str] = []

    def flush() -> None:
        if buf:
            sizes.append((current, len("".join(buf).encode("utf-8"))))

    for line in text.splitlines(keepends=True):
        if line.startswith("## "):
            flush()
            buf = [line]
            current = line[3:].strip()
        else:
            buf.append(line)
    flush()
    return sizes


def fit_tree(fixed: str, lines: list[str], limit: int) -> str:
    """Longest newest-first prefix that fits. The receipt is extra, and always said."""
    header = "## Tree\n"
    kept = -1
    block = ""
    for count in range(len(lines), -1, -1):
        body = header + "".join(f"{line}\n" for line in lines[:count])
        if len((fixed + body).encode("utf-8")) <= limit:
            kept = count
            block = body
            break
    if kept < 0:
        kept = 0
        block = ""
    omitted = len(lines) - kept
    if omitted:
        block += f"omitted {omitted} entries; each is one read away\n"
    return block


def main() -> None:
    if len(sys.argv) != 3:
        die("usage: wake <thread-id> <owed.json>")
    thread = segment(sys.argv[1])
    owed = Path(sys.argv[2])
    limit = budget()
    part = os.environ.get("LOOM_PART")
    if not part:
        die("LOOM_PART is not set")
    loom_path = Path(part)
    if not loom_path.is_file():
        die(f"LOOM_PART: no such file: {part}")
    try:
        loom = loom_path.read_text(encoding="utf-8")
    except UnicodeDecodeError as exc:
        die(f"LOOM_PART: not utf-8: {exc}")
    repos = os.environ.get("LOOM_REPOS")
    if repos:
        repo_path = Path(repos)
        if not repo_path.is_file():
            die(f"LOOM_REPOS: no such file: {repos}")
        try:
            extra = repo_path.read_text(encoding="utf-8")
        except UnicodeDecodeError as exc:
            die(f"LOOM_REPOS: not utf-8: {exc}")
        if extra:
            if not loom.endswith("\n"):
                loom += "\n"
            loom += extra
    root = Path.cwd()
    head, tail = fixed_text(root, thread, loom, owed)
    fixed = head + tail
    total = len(fixed.encode("utf-8"))
    if total > limit:
        head, tail = fixed_text(root, thread, loom, owed, total - limit, limit)
        fixed = head + tail
    total = len(fixed.encode("utf-8"))
    if total > limit:
        sizes = sorted(piece_sizes(fixed), key=lambda item: -item[1])
        largest = ", ".join(f"{name} {size}B" for name, size in sizes[:4])
        die(
            f"over budget: the wake is {total}B, {total - limit}B over its {limit}B budget, "
            f"more than cutting the thread README can give. Largest parts: {largest}. "
            f"core/identity.md, memory/stance.md and the letters are never cut.",
            3,
        )
    out = head + fit_tree(fixed, tree_lines(root, thread), limit) + tail
    core = os.environ.get("LOOM_CORE")
    if core:
        text = core_text(root)
        Path(core).write_text(text, encoding="utf-8")
        out = out[len(text):]
    sys.stdout.write(out)


if __name__ == "__main__":
    main()
