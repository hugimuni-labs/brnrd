#!/bin/sh
# core/immune — the only gate a push to refs/heads/main passes through.
#
#   core/immune <old> <new> [ref]
#   or, with no args, pre-receive lines "<old> <new> <ref>" on stdin.
#
# Exit 0 accepts. Exit 1 refuses: one stderr line per reason, prefixed with
# the check's name. Any ref other than refs/heads/main passes. An empty
# immune.d/ accepts a fast-forward, so the gate works before any check exists.
# Checks are the executable files in core/immune.d/ as committed at <new>,
# run in name order, every one of them, even after an earlier one fails.

zeros_p() {
    case "$1" in
        ""|*[!0]*) return 1 ;;
        *) return 0 ;;
    esac
}

run_checks() {
    old=$1
    new=$2
    tmp=$(mktemp -d "${TMPDIR:-/tmp}/immune.XXXXXX") || {
        printf 'immune: mktemp failed\n' >&2
        return 1
    }
    failed=0
    if ! git archive "$new" core/immune.d >"$tmp/checks.tar" 2>"$tmp/archive.err"; then
        if git cat-file -e "$new:core/immune.d" >/dev/null 2>&1; then
            printf 'immune: cannot extract core/immune.d at %s\n' "$new" >&2
            cat "$tmp/archive.err" >&2
            rm -rf "$tmp"
            return 1
        fi
        # No immune.d yet. Nothing to run.
        rm -rf "$tmp"
        return 0
    fi
    if ! tar -x -C "$tmp" -f "$tmp/checks.tar"; then
        printf 'immune: cannot extract core/immune.d at %s\n' "$new" >&2
        rm -rf "$tmp"
        return 1
    fi
    checkdir=$tmp/core/immune.d
    if [ ! -d "$checkdir" ]; then
        printf 'immune: core/immune.d is not a directory at %s\n' "$new" >&2
        rm -rf "$tmp"
        return 1
    fi
    # Byte order, not the operator's locale, so 10-readme stays before 50-.
    find "$checkdir" -maxdepth 1 -type f -perm -111 | LC_ALL=C sort >"$tmp/list"
    while IFS= read -r check; do
        [ -n "$check" ] || continue
        name=$(basename "$check")
        err=$tmp/err
        : >"$err"
        if [ -n "${LOOM_IMMUNE_SH:-}" ]; then
            "$LOOM_IMMUNE_SH" "$check" "$old" "$new" 2>"$err"
        else
            "$check" "$old" "$new" 2>"$err"
        fi
        rc=$?
        if [ "$rc" -ne 0 ]; then
            failed=1
            if [ -s "$err" ]; then
                while IFS= read -r line || [ -n "$line" ]; do
                    printf '%s: %s\n' "$name" "$line" >&2
                done <"$err"
            else
                # A blank refusal is a polite zero. Name the check anyway.
                printf '%s: failed\n' "$name" >&2
            fi
        fi
    done <"$tmp/list"
    rm -rf "$tmp"
    return "$failed"
}

run_one() {
    old=$1
    new=$2
    ref=${3:-refs/heads/main}
    case "$ref" in
        refs/heads/main) ;;
        *) return 0 ;;
    esac
    if zeros_p "$new"; then
        printf 'immune: refusing deletion of main\n' >&2
        return 1
    fi
    if ! zeros_p "$old"; then
        if ! git merge-base --is-ancestor "$old" "$new" >/dev/null 2>&1; then
            printf 'immune: refusing non-fast-forward to main\n' >&2
            return 1
        fi
    fi
    run_checks "$old" "$new"
}

if [ "$#" -ge 2 ]; then
    run_one "$1" "$2" "${3:-refs/heads/main}"
    exit $?
fi

status=0
while read -r old new ref; do
    [ -n "$old" ] || continue
    run_one "$old" "$new" "$ref" || status=1
done
exit "$status"
